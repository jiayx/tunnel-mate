{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tunnel Mate",
  "version": "0.2.5",
  "identifier": "com.jiayx.tunnel-mate",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tunnel Mate",
        "width": 1024,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "icons/trayTemplate.png",
      "icons/trayTemplate@2x.png"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/jiayx/tunnel-mate/releases/latest/download/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGMzMzQTIxMEVCMkNFMkUKUldRdXpySU9JVG96ejBhRUJoZWhQR04vYUdIL2VtbWJMdGk5bEFCa1FvWEtZaUo3Y0lGTC9mdmEK"
    }
  }
}
