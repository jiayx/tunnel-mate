{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tunnel Mate",
  "version": "0.1.0",
  "identifier": "com.jiayx.tunnel-mate",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tunnel Mate",
        "width": 1024,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "icons/trayTemplate.png",
      "icons/trayTemplate@2x.png"
    ]
  }
}
